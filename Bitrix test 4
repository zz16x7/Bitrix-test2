         "Неверный срок действия (месяц 01-12)"),
        # CVV слишком короткий
        ("4532015112830366", valid_ex, "12", "JOHN DOE",
         "Неверный CVV (должен быть 3-4 цифры)"),
        # CVV слишком длинный
        ("4532015112830366", valid_ex, "12345", "JOHN DOE",
         "Неверный CVV (должен быть 3-4 цифры)"),
        # Кириллица в имени
        ("4532015112830366", valid_ex, "123", "ИВАН ИВАНОВ",
         "Неверное имя держателя (только латинские буквы и пробелы)"),
        # Имя из одной буквы
        ("4532015112830366", valid_ex, "123", "J",
