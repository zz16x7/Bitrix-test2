        # Номер слишком короткий
        ("1234", valid_ex, "123", "JOHN DOE",
         "Неверный номер карты (длина 13-19 цифр)"),
        # Цифры в имени
        ("4532015112830366", valid_ex, "123", "JOHN123 DOE",
         "Неверное имя держателя (только латинские буквы и пробелы)"),
        # Несколько ошибок сразу
        ("1234", expired_ex, "1", "J",
         "Неверный номер карты (длина 13-19 цифр); "
         "Срок действия карты истёк; "
         "Неверный CVV (должен быть 3-4 цифры); "
         "Неверное имя держателя (длина 2-26 символов)"),
