    print("=== Тесты ===")
    all_ok = True
    for number, expiry, cvv, name, expected in tests:
        actual = validate_card(number, expiry, cvv, name)
        status = "OK" if actual == expected else "FAIL"
        if status == "FAIL":
            all_ok = False
        print(f"[{status}] {number!r} | {expiry!r} | {cvv!r} | {name!r}")
