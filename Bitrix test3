def boundary_values(a: int, b: int):
    """
    Возвращает значения для проверки методом граничных значений
    для диапазона [a, b] включительно: a-1, a, a+1, b-1, b, b+1.
    Без повторов, по возрастанию.

    Возвращает:
      - list[int]                     — при корректных данных;
      - "Некорректные данные"         — если a или b не целые числа;
      - "Некорректный диапазон"       — если a > b.
    """
    # Проверка типа: bool — подкласс int, но по смыслу это не «целое число»
    if not isinstance(a, int) or isinstance(a, bool) \
       or not isinstance(b, int) or isinstance(b, bool):
        return "Некорректные данные"

    # Проверка диапазона
    if a > b:
        return "Некорректный диапазон"

    # Собираем все 6 кандидатов, убираем дубли, сортируем
    return sorted({a - 1, a, a + 1, b - 1, b, b + 1})


# ---------- Тесты ----------
if __name__ == "__main__":
    cases = [
        ((1, 100), [0, 1, 2, 99, 100, 101]),
        ((5, 5),   [4, 5, 6]),
        ((100, 1), "Некорректный диапазон"),
        ((1, 2),   [0, 1, 2, 3]),            # дубли схлопываются
        ((0, 0),   [-1, 0, 1]),
        ((-5, 5),  [-6, -5, -4, 4, 5, 6]),
        ((1.5, 10), "Некорректные данные"),
        ((1, "10"), "Некорректные данные"),
        ((True, 10), "Некорректные данные"), # bool не считается целым
    ]

    for args, expected in cases:
        actual = boundary_values(*args)
        status = "OK" if actual == expected else "FAIL"
        print(f"[{status}] boundary_values{args} -> {actual}")
        if status == "FAIL":
            print(f"        ожидалось: {expected}")
